{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Event Flyer Generator Demo",
		"author": "coreyhall93",
		"description": "Try the Event Flyer Generator with GatherPress: pick events, generate a printable flyer. No install required."
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/Automattic/themes",
				"ref": "trunk",
				"path": "assembler"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/coreyhall93/event-flyer-generator",
				"ref": "master"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "gatherpress"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "wp-cli",
			"command": "wp eval 'EFG_Events::seed_demo_content();'"
		}
	]
}
