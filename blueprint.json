{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Event Flyer Generator Demo",
		"author": "coreyhall93",
		"description": "Try the Event Flyer Generator plugin on the Assembler theme, no install required."
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/Automattic/themes",
				"ref": "trunk",
				"path": "assembler"
			},
			"options": { "activate": true }
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/coreyhall93/event-flyer-generator",
				"ref": "master"
			},
			"options": { "activate": true }
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require_once '/wordpress/wp-content/plugins/event-flyer-generator/demo/seed.php';"
		}
	]
}
